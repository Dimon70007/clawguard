{
  "name": "@capsulesecurity/clawguard",
  "version": "0.1.7",
  "description": "Security guard plugin for OpenClaw - uses LLM as a Judge to detect and block risky tool calls",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node --test --experimental-strip-types resolve-judge.test.ts"
  },
  "keywords": [
    "openclaw",
    "security",
    "llm",
    "agent",
    "guardrails"
  ],
  "author": "Capsule Security",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dimon70007/clawguard.git"
  },
  "homepage": "https://github.com/Dimon70007/clawguard#readme",
  "bugs": {
    "url": "https://github.com/Dimon70007/clawguard/issues"
  },
  "peerDependencies": {
    "openclaw": ">=2026.2.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  }
}
